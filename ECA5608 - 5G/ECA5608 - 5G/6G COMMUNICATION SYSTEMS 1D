% Graphical Comparison of FDMA, TDMA and CDMA

clc;
clear;
close all;

% Create Figure and Layout
figure;
tiledlayout(1,3);

% Define Colors for Users
colors = lines(4);

%% 1. FDMA: Users Occupy Different Frequency Channels
nexttile;
hold on;

for u = 1:4
    rectangle('Position', [0, u-1, 1, 0.8], ...
        'FaceColor', colors(u,:), ...
        'EdgeColor', 'k');

    text(0.5, u-0.6, sprintf('User %d', u), ...
        'HorizontalAlignment', 'center');
end

xlim([0 1]);
ylim([0 4]);

xlabel('Time');
ylabel('Frequency channel');
title('FDMA');

set(gca, 'YTick', []);
hold off;

%% 2. TDMA: Users Occupy Different Time Slots
nexttile;
hold on;

for u = 1:4
    rectangle('Position', [u-1, 0, 0.8, 1], ...
        'FaceColor', colors(u,:), ...
        'EdgeColor', 'k');

    text(u-0.6, 0.5, sprintf('User %d', u), ...
        'HorizontalAlignment', 'center');
end

xlim([0 4]);
ylim([0 1]);

xlabel('Time slot');
ylabel('Frequency channel');
title('TDMA');

set(gca, 'YTick', []);
hold off;

%% 3. CDMA: Users Share Time and Frequency Using Different Codes
nexttile;
hold on;

for u = 1:4
    rectangle('Position', [0, 0, 1, 1], ...
        'FaceColor', colors(u,:), ...
        'FaceAlpha', 0.22, ...
        'EdgeColor', colors(u,:), ...
        'LineWidth', 1.5);
end

text(0.5, 0.62, 'Users 1-4 share', ...
    'HorizontalAlignment', 'center');

text(0.5, 0.40, 'band; different codes', ...
    'HorizontalAlignment', 'center');

xlim([0 1]);
ylim([0 1]);

xlabel('Time');
ylabel('Frequency band');
title('CDMA');

set(gca, 'YTick', []);
hold off;

%% Overall Figure Title
sgtitle('Conceptual Time-Frequency Resource Allocation');
