clc;
clear;
close all;

%% 6G IRS-Assisted Communication Simulation

%% 1. Input Parameters

c = 3e8;              % Speed of light (m/s)
f = 100e9;            % Carrier frequency (100 GHz)
Pt = 20;              % Transmit power (dBm)
Gt = 10;              % Transmitter antenna gain (dB)
Gr = 10;              % Receiver antenna gain (dB)

d1 = 50;              % Distance from transmitter to IRS (m)
d2 = 50;              % Distance from IRS to receiver (m)

eta = 0.8;            % IRS reflection efficiency

%% 2. Wavelength Calculation

lambda = c/f;

%% 3. Direct Communication Distance

d_direct = d1 + d2;

%% 4. Free Space Path Loss - Direct Link

PL_direct = 20*log10(4*pi*d_direct/lambda);

%% 5. Direct Received Power

Pr_direct = Pt + Gt + Gr - PL_direct;

%% 6. IRS Element Configuration

N = [16 32 64 128 256];

%% 7. Total IRS Path Loss

PL_IRS = 20*log10(4*pi*d1/lambda) + ...
         20*log10(4*pi*d2/lambda);

%% 8. IRS Gain Calculation

IRS_gain = 10*log10(N*eta);

%% 9. IRS-Assisted Received Power

Pr_IRS = Pt + Gt + Gr - PL_IRS + IRS_gain;

%% 10. IRS Gain Improvement

Gain_improvement = Pr_IRS - Pr_direct;

%% 11. Display Simulation Results

fprintf('\n6G IRS-Assisted Communication Simulation\n');

fprintf('=========================================\n');

fprintf('Carrier Frequency = %.2f GHz\n', f/1e9);

fprintf('Wavelength = %.4f m\n', lambda);

fprintf('Direct Path Loss = %.2f dB\n', PL_direct);

fprintf('Direct Received Power = %.2f dBm\n', Pr_direct);

fprintf('\nIRS Results:\n');

fprintf('-----------------------------------------\n');

for k = 1:length(N)

    fprintf('N = %d | IRS Gain = %.2f dB\n', ...
        N(k), IRS_gain(k));

    fprintf('Received Power = %.2f dBm | ', Pr_IRS(k));

    fprintf('Improvement = %.2f dB\n', ...
        Gain_improvement(k));

    fprintf('-----------------------------------------\n');

end

%% 12. Plot 1 - IRS Elements vs Received Power

figure('Name','IRS Elements vs Received Power');

plot(N, Pr_IRS, '-o', 'LineWidth', 2);

hold on;

yline(Pr_direct, '--', 'Direct Link');

grid on;

xlabel('Number of IRS Elements');

ylabel('Received Power (dBm)');

title('IRS Elements vs Received Power');

legend('IRS-Assisted', 'Direct Link', 'Location', 'best');

hold off;

%% 13. Plot 2 - IRS Elements vs Gain Improvement

figure('Name','IRS Gain Improvement');

plot(N, Gain_improvement, '-s', 'LineWidth', 2);

grid on;

xlabel('Number of IRS Elements');

ylabel('Gain Improvement (dB)');

title('IRS Gain Improvement for 6G Communication');

%% 14. Plot 3 - Path Loss vs Distance

distance = 10:10:200;

PL = 20*log10(4*pi*distance/lambda);

figure('Name','Path Loss vs Distance');

plot(distance, PL, '-o', 'LineWidth', 2);

grid on;

xlabel('Distance (m)');

ylabel('Path Loss (dB)');

title('6G High-Frequency Path Loss vs Distance');
